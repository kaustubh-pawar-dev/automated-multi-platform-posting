# Copy this file to ".env" and adjust values. NEVER commit ".env".
# Leave a platform's values blank to disable it.

# --- Application ---
ENVIRONMENT=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=INFO

# --- Outbound HTTP behaviour ---
HTTP_TIMEOUT_SECONDS=10
HTTP_CONNECT_TIMEOUT_SECONDS=5
MAX_CONCURRENT_PLATFORMS=5
MAX_RETRIES=2
RETRY_BACKOFF_BASE_SECONDS=0.5

# --- Mastodon ---
# Instance origin, e.g. https://mastodon.social (https only, no path).
# Token: Preferences > Development > New application, scope write:statuses only.
MASTODON_INSTANCE_URL=
MASTODON_ACCESS_TOKEN=

# --- Bluesky ---
# Handle, e.g. yourname.bsky.social. Use an APP PASSWORD, never your main password:
# Settings > Privacy and security > App passwords.
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# Only change for a self-hosted PDS:
# BLUESKY_SERVICE_URL=https://bsky.social