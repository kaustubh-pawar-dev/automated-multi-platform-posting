# Copy this file to ".env" and adjust values. NEVER commit ".env".
# Leave a platform's values blank to disable it.

# --- Application ---
ENVIRONMENT=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=INFO

# --- Outbound HTTP behaviour ---
HTTP_TIMEOUT_SECONDS=10
HTTP_CONNECT_TIMEOUT_SECONDS=5
MAX_CONCURRENT_PLATFORMS=5
MAX_RETRIES=2
RETRY_BACKOFF_BASE_SECONDS=0.5

# --- Mastodon ---
# Instance origin, e.g. https://mastodon.social (https only, no path).
# Token: Preferences > Development > New application, scope write:statuses only.
MASTODON_INSTANCE_URL=
MASTODON_ACCESS_TOKEN=

# --- Bluesky ---
# Handle, e.g. yourname.bsky.social. Use an APP PASSWORD, never your main password:
# Settings > Privacy and security > App passwords.
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# Only change for a self-hosted PDS:
# BLUESKY_SERVICE_URL=https://bsky.social

# --- Telegram ---
# Create a bot with @BotFather, add it to your channel as an administrator with
# "Post Messages". Chat id is @channelusername (public channel) or a numeric id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- LinkedIn ---
# Run scripts\linkedin_authorize.py once; it prints these three values.
# Self-serve tokens last about 60 days, then the script must be run again.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
LINKEDIN_TOKEN_EXPIRES_AT=
# Only change if LinkedIn sunsets this API version (format YYYYMM):
# LINKEDIN_API_VERSION=202608

# --- Discord ---
# Server Settings > Integrations > Webhooks > New Webhook > Copy Webhook URL.
# The URL contains a secret token: treat it like a password.
DISCORD_WEBHOOK_URL=
# Optional: numeric server id (enable Developer Mode, right-click the server, Copy Server ID).
# Only needed to get a post link in the response.
DISCORD_GUILD_ID=