# Copy this file to ".env" and adjust values. NEVER commit ".env".
# Platform credentials are added in later steps, after API research.

# --- Application ---
ENVIRONMENT=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=INFO

# --- Outbound HTTP behaviour ---
HTTP_TIMEOUT_SECONDS=10
HTTP_CONNECT_TIMEOUT_SECONDS=5
MAX_CONCURRENT_PLATFORMS=5
MAX_RETRIES=2
RETRY_BACKOFF_BASE_SECONDS=0.5